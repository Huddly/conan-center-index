FROM artifactory.huddly.io/falcontest-docker-prod-local/ubuntu2204_build:1.0.8

ARG DOCKER_USER_UID=1003
ENV PYTHONUNBUFFERED=1
USER root

RUN usermod -u $DOCKER_USER_UID jenkins

WORKDIR /tmp
COPY install-build-dependencies.sh .
RUN ./install-build-dependencies.sh
RUN echo 'jenkins ALL= NOPASSWD: ALL' >> /etc/sudoers

# download Ambarella toolchain
WORKDIR /tmp/toolchain/
RUN wget http://ci0.oslo.huddly.io/Ambarella_CortexA76_Toolchain_GCC12.2_202304.tar.xz -q -O Ambarella_CortexA76_Toolchain_GCC12.2_202304.tar.xz \
  && echo 413ea40fb114c37953e15b22fe855b7936281f988dd94eec1b7f794ffde62519 Ambarella_CortexA76_Toolchain_GCC12.2_202304.tar.xz | sha256sum -c \
  && tar -xf Ambarella_CortexA76_Toolchain_GCC12.2_202304.tar.xz --strip-components=1 \
  && mkdir -p /usr/local/bin/ \
  && tar -xf toolchain-2023.04/armv8/aarch64/cortex-a76-2023.04-gcc12.2-linux5.15-x86_64.tar.xz -C /usr/local/ \
  && gcc -o /usr/local/bin/makedevs -O2 -g3 -Wall makedevs/makedevs.c \
  && ln -sf $(which mkfs.cramfs) /usr/local/sbin/mkcramfs \
  && rm -fr /tmp/toolchain/

RUN apt-get -y install openjdk-19-jdk && apt-get clean

#More recent U-Boot tools version with fix for dumpimage @ support, see https://github.com/Huddly/buildroot/pull/5 for details
RUN mkdir -p /tmp/u-boot-sources && \
  curl -L https://github.com/u-boot/u-boot/archive/refs/tags/v2023.04.tar.gz | tar -C /tmp/u-boot-sources --strip-components=1 -xz && \
  cd /tmp/u-boot-sources && \
  sed -i 's/CONFIG_TOOLS_MKEFICAPSULE=y/# CONFIG_TOOLS_MKEFICAPSULE is not set/' configs/tools-only_defconfig && \
  make tools-only_defconfig && \
  make tools-only -j$(nproc) && \
  mkdir -p /usr/local/bin && \
  cp -a tools/mkimage tools/dumpimage tools/mkenvimage /usr/local/bin


USER jenkins
WORKDIR /tmp

ENV POETRY_HOME="/home/jenkins/poetry"
RUN curl -sSL https://install.python-poetry.org | python3 - --version 1.8.3
ENV PATH="${POETRY_HOME}/bin:${PATH}"

# These files are generated by run_in_docker.py:
COPY python-projects.tar setup_poetry.sh poetry-env-entrypoint.sh ./
RUN ./setup_poetry.sh

# Entrypoint to the poetry virtual environment, for docker/*_requirements
ENV MAIN_POETRY_PROJECT_PATH="/tmp/python/docker/*_requirements"
ENTRYPOINT ["/tmp/poetry-env-entrypoint.sh"]

ENV PATH="/home/jenkins/.local/bin:${PATH}"
